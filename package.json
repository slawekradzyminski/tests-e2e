{
  "name": "tests-e2e-evaluation",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/with-anthropic.mjs e2e run",
    "test:smoke": "node scripts/with-anthropic.mjs e2e run tests/smoke.e2e.ts",
    "test:api": "e2e run tests/api",
    "test:ui": "node scripts/with-anthropic.mjs e2e run tests/ui",
    "test:ai": "node scripts/with-anthropic.mjs e2e run --tag ai",
    "typecheck": "tsc --noEmit",
    "verify:coverage": "node scripts/verify-coverage.mjs",
    "cost:report": "node scripts/evaluate-cost.mjs",
    "test:semantic": "node scripts/with-anthropic.mjs e2e run --tag semantic",
    "test:deterministic": "node scripts/run-profile.mjs deterministic",
    "test:actions": "node scripts/run-profile.mjs actions",
    "test:judgments": "node scripts/run-profile.mjs judgments"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@e2e-dev/web": "0.11.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^24",
    "ai": "7.0.127",
    "e2e": "0.15.1",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
